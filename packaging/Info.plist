<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>stupid simulator</string>
  <key>CFBundleDisplayName</key><string>stupid simulator</string>
  <key>CFBundleIdentifier</key><string>net.stupidtech.stupidsimulator</string>
  <key>CFBundleExecutable</key><string>StupidSimulator</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
  <key>CFBundleShortVersionString</key><string>__MARKETING_VERSION__</string>
  <key>CFBundleVersion</key><string>__BUILD_NUMBER__</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>NSHumanReadableCopyright</key><string>MIT licensed. A fork of OpenDeviceHub. Not affiliated with or endorsed by Apple.</string>
  <key>LSApplicationCategoryType</key><string>public.app-category.developer-tools</string>

  <!-- Links that name a device. `devices` belongs to Device Hub by default; claiming it here only
       matters once someone chooses this app in Settings, and a link this app does not understand is
       handed back to Device Hub rather than swallowed. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>net.stupidtech.stupidsimulator.open</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleURLSchemes</key><array><string>stupidsim</string></array>
    </dict>
    <dict>
      <key>CFBundleURLName</key><string>net.stupidtech.stupidsimulator.devices</string>
      <key>CFBundleTypeRole</key><string>Viewer</string>
      <key>CFBundleURLSchemes</key><array><string>devices</string></array>
    </dict>
  </array>

  <!-- Sparkle. The feed (SUFeedURL) and the key (SUPublicEDKey) are what make this a release build:
       without both, the updater is never created. Upstream's were removed so this fork can never
       update itself into OpenDeviceHub; add this fork's own once it publishes a signed feed. Neither
       may change once a version has shipped. -->
  <key>SUEnableAutomaticChecks</key><true/>
  <key>SUScheduledCheckInterval</key><integer>86400</integer>
  <!-- The user decides when to install. Silent installation is off deliberately. -->
  <key>SUAutomaticallyUpdate</key><false/>
</dict>
</plist>
