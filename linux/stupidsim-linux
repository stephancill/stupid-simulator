def fail(message):
    print(f"stupidsim-linux: {message}", file=sys.stderr)
    sys.exit(1)


def log(message):
    print(message, flush=True)


# ---------------------------------------------------------------- x86Sim on this machine

def data_home():
    return os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")


def x86sim_data():
    return os.environ.get("X86SIM_DATA") or os.path.join(data_home(), "x86sim")


def x86sim_cache():
    return os.environ.get("X86SIM_CACHE") or os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "x86sim")


def launcher():
    """x86Sim's extracted AppRun, as stupidsim finds it (see Host/X86Sim/X86SimInstall.swift)."""
    return os.environ.get("STUPIDSIM_X86SIM") or os.path.join(data_home(), "stupidsim", "x86sim", "AppRun")


def device_dir(name):
    return os.path.join(x86sim_data(), "var", "device-a64" if name in ("", "default") else f"device-a64-{name}")


def run_x86sim(args, device=None, env=None, check=True, capture=False, unset=()):
    environment = dict(os.environ, SHELL="/bin/bash")
    if device:
        environment.update(X86SIM_DEVICE=device, A64_DEVICE=device)
    environment.update(env or {})
    for name in unset:
        environment.pop(name, None)
    result = subprocess.run([launcher()] + args, env=environment, text=True,
                            stdout=subprocess.PIPE if capture else None, stderr=subprocess.STDOUT if capture else None)
    if check and result.returncode != 0:
        fail(f"x86sim {' '.join(args)} failed with status {result.returncode}" + (f": {result.stdout[-2000:]}" if capture else ""))
    return result


def install_x86sim():
    """The pinned AppImage from x86Sim's GitHub release, checked and extracted, again whenever the pin changes (the
    extraction's .stupidsim-sha256 names the AppImage it came from, as packaging/linux/install.sh writes it)."""
    target = launcher()
    root = os.path.dirname(target)
    if os.environ.get("STUPIDSIM_X86SIM"):
        if not os.path.exists(target):
            fail(f"STUPIDSIM_X86SIM names {target}, which does not exist")
        return
    try:
        with open(os.path.join(root, ".stupidsim-sha256")) as f:
            if os.path.exists(target) and f.read().strip() == X86SIM_SHA256:
                return
    except FileNotFoundError:
        pass
    os.makedirs(os.path.dirname(root), exist_ok=True)
    image = root + ".AppImage"
    log(f"downloading x86Sim {X86SIM_VERSION}")
    subprocess.run(["curl", "-fsSL", "-o", image + ".part", X86SIM_URL], check=True)
    if sha256_file(image + ".part") != X86SIM_SHA256:
        os.remove(image + ".part")
        fail(f"the x86Sim download does not match {X86SIM_VERSION}'s published checksum")
    os.chmod(image + ".part", 0o755)
    os.replace(image + ".part", image)
    scratch = tempfile.mkdtemp(dir=os.path.dirname(root))
    subprocess.run([image, "--appimage-extract"], cwd=scratch, check=True, stdout=subprocess.DEVNULL)
    with open(os.path.join(scratch, "squashfs-root", ".stupidsim-sha256"), "w") as f:
        f.write(X86SIM_SHA256 + "\n")
    shutil.rmtree(root, ignore_errors=True)
    os.replace(os.path.join(scratch, "squashfs-root"), root)
    shutil.rmtree(scratch, ignore_errors=True)
    os.remove(image)  # extracted; the AppImage itself is never run (it leaves a FUSE mount per run)
    log(f"x86Sim {X86SIM_VERSION} is at {root}")


SYSTEM_DARLING = "/opt/x86sim/darling"


def ensure_darling():
    """x86Sim runs Darling either from /opt/x86sim (its "system" mode: a setuid root launcher installed by its
    install-helper.sh) or through an unprivileged user namespace ("userns" mode), and picks system mode when the
    installed build matches. Userns mode of x86Sim 0.5.0 could not start a container on Ubuntu 24.04 (WSL 2, kernel
    6.18), as root or as a user ("Cannot switch to your user and group ids", then "Timed out waiting for shellspawn");
    system mode worked. So the matching Darling is installed into /opt/x86sim here, as root (setup in a cloud session
    runs as root); without root, this fails with the command to run."""
    if os.environ.get("STUPIDSIM_X86SIM"):
        return
    share = os.path.join(os.path.dirname(launcher()), "usr", "share", "x86sim")
    with open(os.path.join(share, "DARLING_ID")) as f:
        darling_id = f.read().strip()
    try:
        with open(os.path.join(SYSTEM_DARLING, ".x86sim-complete")) as f:
            installed = f.read().strip()
    except OSError:
        installed = None
    launcher_bin = os.path.join(SYSTEM_DARLING, "bin", "darling")
    if installed == darling_id and os.path.exists(launcher_bin) and os.stat(launcher_bin).st_mode & stat.S_ISUID:
        return
    command = ["sh", os.path.join(share, "install-helper.sh"), "install", os.path.join(share, "darling"), darling_id]
    if os.geteuid() != 0:
        fail(f"x86Sim's Darling {darling_id} is not installed in /opt/x86sim; install it as root with: sudo {' '.join(command)}")
    result = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if result.returncode != 0:
        fail(f"installing Darling into /opt/x86sim failed: {result.stdout.strip()}")
    # The extracted AppImage's directories are mode 700 and the helper only removes write bits, so a user other than
    # root could not reach the setuid launcher, and x86Sim fell back to userns mode for them.
    subprocess.run(["chmod", "-R", "a+rX", os.path.join("/opt/x86sim", f"darling-{darling_id}")], check=True)
    log(f"installed x86Sim's Darling {darling_id} into /opt/x86sim")


def sha256_file(path):
    digest = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def runtime_dir(runtime):
    return os.path.join(x86sim_data(), "runtimes", runtime)


def runtime_root(runtime):
    """RuntimeRoot inside extracted/, found by name since the simruntime's folder carries the version."""
    extracted = os.path.join(runtime_dir(runtime), "extracted")
    runtimes = os.path.join(extracted, RUNTIME_ROOT_PREFIX)
    for name in sorted(os.listdir(runtimes)) if os.path.isdir(runtimes) else []:
        candidate = os.path.join(runtimes, name, "Contents/Resources/RuntimeRoot")
        if os.path.isdir(candidate):
            return candidate
    fail(f"no RuntimeRoot under {runtimes}")


def device_runtime(device):
    with open(os.path.join(device, "runtime")) as f:
        return f.read().strip()


def is_booted(device):
    import socket
    sock = os.path.realpath(os.path.join(device, "data", "simhid.sock"))
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.connect(sock)
        return True
    except OSError:
        return False


def vulkan_env(metal):
    """Metal on the GPU's Vulkan driver, on lavapipe (Vulkan on the CPU), or x86Sim's software renderer.
    WSL's dozen drew corrupt frames (x86Sim 0.3.0), so auto prefers lavapipe on WSL and wherever
    there is no GPU."""
    lavapipe = "/usr/share/vulkan/icd.d/lvp_icd.json"
    gpu = os.path.exists("/dev/dri") and not os.path.exists("/dev/dxg")
    if metal == "auto":
        metal = "gpu" if gpu else "lavapipe" if os.path.exists(lavapipe) else "software"
    if metal == "software":
        return {"X86SIM_METAL": "0"}
    if metal == "gpu":
        return {"X86SIM_METAL": "all"}
    if not os.path.exists(lavapipe):
        fail("--metal lavapipe needs Mesa's lavapipe (apt install mesa-vulkan-drivers)")
    return {"X86SIM_METAL": "all", "VK_DRIVER_FILES": lavapipe, "VK_ICD_FILENAMES": lavapipe}


def ensure_runtime_dir():
    """simfb writes the frame ring to /run/user/<uid> (x86Sim's mksimdevice.py), which only systemd-logind creates.
    Containers and VMs without it (Claude Code cloud sessions) booted fine but had no frames, so screenshots failed."""
    path = f"/run/user/{os.getuid()}"
    if os.path.isdir(path):
        return
    try:
        os.makedirs(path, mode=0o700)
    except OSError as error:
        fail(f"{path} does not exist and could not be created ({error.strerror}); x86Sim writes the screen's frames "
             f"there. Create it as root: mkdir -p {path} && chown {os.getuid()}:{os.getgid()} {path} && chmod 700 {path}")


def boot(name, metal="auto", timeout=900):
    device = device_dir(name)
    if not os.path.isdir(device):
        fail(f"no device {name} at {device}")
    if is_booted(device):
        log(f"{name} is already booted")
        return
    started = time.time()
    ensure_runtime_dir()
    ensure_darling()
    runtime = device_runtime(device)
    if is_lazy(runtime):
        mount_lazy(runtime)
    env = dict(vulkan_env(metal), A64_KEEP="1")
    # Without DISPLAY: the screen comes from simfb, not X. Darling's iokitd opens an X display on its main thread before
    # it answers any Mach message, and every guest process that touches IOKit waits for it, so a DISPLAY whose server
    # does not answer stalls the boot. x86Sim 0.3.0's iokitd still falls back to :0 without it (removed in 0.4.0); see
    # docs/implementation-notes.md for the WSL 2 box where both hung.
    run_x86sim(["shell", "-c", "cli/libexec/arm64/boot-a64.sh"], device=device, env=env, unset=("DISPLAY",))
    run_x86sim(["x86sim", "wait", "home", str(timeout)], device=device)
    if not is_booted(device):
        fail(f"{name} reached the home screen but its input socket does not answer")
    log(f"{name} booted in {time.time() - started:.0f} s")


def shutdown(name):
    device = device_dir(name)
    run_x86sim(["shell", "-c", "cli/libexec/arm64/boot-a64.sh"], device=device, env={"A64_STOP_ONLY": "1"})
    for _ in range(60):
        if not is_booted(device):
            return
        time.sleep(0.5)
    fail(f"{name} is still answering after being stopped")


# ---------------------------------------------------------------- tracing

def set_access_times(root, when):
    count = 0
    for directory, _, files in os.walk(root):
        for name in files:
            path = os.path.join(directory, name)
            if os.path.islink(path):
                continue
            os.utime(path, ns=(when * 10**9, os.lstat(path).st_mtime_ns), follow_symlinks=False)
            count += 1
    return count


def check_access_times_record(root):
    """A file system mounted noatime records no reads, which would make every trace empty."""
    for directory, _, files in os.walk(root):
        for name in files:
            path = os.path.join(directory, name)
            if os.path.islink(path) or os.path.getsize(path) == 0:
                continue
            with open(path, "rb") as f:
                f.read(1)
            if os.stat(path).st_atime <= UNREAD_EPOCH + 86400:
                fail(f"reading {path} did not update its access time: the file system is mounted noatime, so reads cannot be traced")
            os.utime(path, ns=(UNREAD_EPOCH * 10**9, os.lstat(path).st_mtime_ns))
            return


def trace_begin(name):
    device = device_dir(name)
    runtime = device_runtime(device)
    if is_booted(device):
        log(f"stopping {name}")
        shutdown(name)
    if is_lazy(runtime):
        # The lazy file system records every file opened through it (layers/opened.txt): remount it so the trace
        # starts empty. Files in the fetched packs never reach it, so a trace there is what the packs lack.
        unmount_lazy(runtime)
        open(os.path.join(layers_dir(runtime), "opened.txt"), "w").close()
        log(f"tracing what {name} opens beyond the fetched packs; booting {name}")
        boot(name)
        log("now use the app the way its tests will, then run: stupidsim-linux trace end <name>")
        return
    root = runtime_root(runtime)
    count = set_access_times(root, UNREAD_EPOCH)
    check_access_times_record(root)
    log(f"marked {count} runtime files unread; booting {name}")
    boot(name)
    log("now use the app the way its tests will, then run: stupidsim-linux trace end <name>")


def read_since_trace(root):
    """Leaves out x86Sim's own per-device files, which it writes into the runtime at boot
    (LaunchAngels/.x86sim-device-a64-<name>/...) and removes again: they are not Apple's, and
    they come and go with the device."""
    read = []
    for directory, dirs, files in os.walk(root):
        dirs[:] = [d for d in dirs if not d.startswith(".x86sim-")]
        for name in files:
            path = os.path.join(directory, name)
            if not os.path.islink(path) and os.stat(path, follow_symlinks=False).st_atime > UNREAD_EPOCH + 86400:
                read.append(os.path.relpath(path, root))
    return sorted(read)


def manifests_dir():
    return os.environ.get("STUPIDSIM_MANIFESTS") or os.path.join(data_home(), "stupidsim", "manifests")


def read_manifest(runtime, name):
    path = os.path.join(manifests_dir(), runtime, f"{name}.txt")
    if not os.path.exists(path):
        fail(f"no manifest {name} for {runtime} at {path}")
    with open(path) as f:
        return [line.rstrip("\n") for line in f if line.strip() and not line.startswith("#")]


def trace_end(trace_name, device_name, base):
    device = device_dir(device_name)
    runtime = device_runtime(device)
    root = runtime_root(runtime)
    if is_lazy(runtime):
        prefix = os.path.relpath(root, lazy_paths(runtime)["extracted"]) + "/"
        with open(os.path.join(layers_dir(runtime), "opened.txt")) as f:
            read = sorted({line[len(prefix):].rstrip("\n") for line in f if line.startswith(prefix)})
    else:
        read = read_since_trace(root)
    skip = set(read_manifest(runtime, base)) if base else set()
    paths = [p for p in read if p not in skip]
    size = sum(os.path.getsize(os.path.join(root, p)) for p in paths)
    out = os.path.join(manifests_dir(), runtime, f"{trace_name}.txt")
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w") as f:
        f.write(f"# runtime files read while tracing {trace_name} on {runtime}"
                + (f", less those in {base}" if base else "") + "; paths under RuntimeRoot\n")
        f.writelines(p + "\n" for p in paths)
    log(f"{out}: {len(paths)} files, {size / 1e9:.2f} GB")


# ---------------------------------------------------------------- the store

def store_env():
    url = os.environ.get("STUPIDSIM_STORE_URL", "").rstrip("/")
    key, secret = os.environ.get("STUPIDSIM_STORE_KEY_ID"), os.environ.get("STUPIDSIM_STORE_SECRET")
    if not url:
        fail("STUPIDSIM_STORE_URL is not set (the store bucket's S3 endpoint, https://<account>.r2.cloudflarestorage.com/<bucket>)")
    return url, key, secret


def curl_store(key, extra, signed=True):
    url, key_id, secret = store_env()
    command = ["curl", "-fsS", "--retry", "3", "--retry-all-errors"]
    if signed:
        if not key_id or not secret:
            fail("STUPIDSIM_STORE_KEY_ID and STUPIDSIM_STORE_SECRET are not set")
        command += ["--aws-sigv4", "aws:amz:auto:s3", "--user", f"{key_id}:{secret}"]
    return command + extra + [f"{url}/{urllib.parse.quote(key)}"]


CURL_GET = ["curl", "-fsS", "--retry", "3", "--retry-all-errors"]


@functools.cache
def public_store():
    """The public address, or None when this network cannot reach it. Claude Code cloud sessions
    sit behind a proxy that refuses hosts outside its allowlist (CONNECT 403) but allows R2's S3
    endpoint, so reads then go there, signed with the store's read-only key (READ_KEY_ID)."""
    base = (os.environ.get("STUPIDSIM_PUBLIC_STORE") or PUBLIC_STORE).rstrip("/")
    probe = subprocess.run(["curl", "-fsS", "--max-time", "15", "-o", "/dev/null", f"{base}/current.json"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if probe.returncode == 0:
        return base
    log(f"{base} is not reachable from here; reading the store through R2's S3 endpoint instead")
    return None


def read_command(key):
    """curl arguments that print one store object. In order: a store directory on this machine in
    $STUPIDSIM_LOCAL_STORE; a presigned URL in
    $STUPIDSIM_STORE_URLS (a JSON map of key to URL); signed with $STUPIDSIM_STORE_KEY_ID when set;
    the public address; signed with the embedded read-only key."""
    links = json.loads(os.environ.get("STUPIDSIM_STORE_URLS") or "{}")
    if os.environ.get("STUPIDSIM_LOCAL_STORE"):  # a store directory on this machine (testing a store before publishing)
        return CURL_GET + ["file://" + urllib.parse.quote(os.path.join(os.path.abspath(os.environ["STUPIDSIM_LOCAL_STORE"]), key))]
    if key in links:
        return CURL_GET + [links[key]]
    if os.environ.get("STUPIDSIM_STORE_KEY_ID"):
        return curl_store(key, [])
    base = public_store()
    if base:
        return CURL_GET + [f"{base}/{urllib.parse.quote(key)}"]
    return CURL_GET + ["--aws-sigv4", "aws:amz:auto:s3", "--user", f"{READ_KEY_ID}:{READ_SECRET}",
                       f"{READ_ENDPOINT}/{urllib.parse.quote(key)}"]


def store_get(key):
    return subprocess.run(read_command(key), check=True, stdout=subprocess.PIPE).stdout


def fetch_and_extract(key, destination):
    """Streams a .tar.zst from the store into a directory, never holding the archive on disk."""
    os.makedirs(destination, exist_ok=True)
    curl = subprocess.Popen(read_command(key), stdout=subprocess.PIPE)
    # --no-same-owner: as root, tar keeps the archive's owner (the uid that built the store). x86Sim's processes then
    # cannot create the translation cache's lock and shared image (.map) files, so every process loads its own private
    # copy of the AOT image (about 1.2 GB each) and a 16 GB machine runs out of memory within seconds of booting.
    tar = subprocess.run(["tar", "--zstd", "--no-same-owner", "-xf", "-", "-C", destination], stdin=curl.stdout)
    curl.stdout.close()
    if curl.wait() != 0 or tar.returncode != 0:
        fail(f"could not fetch and unpack {key} (curl {curl.returncode}, tar {tar.returncode})")
    return key


def fetch_file(key, destination):
    """One zstd-compressed store object, unpacked to a file."""
    os.makedirs(os.path.dirname(destination), exist_ok=True)
    with open(destination + ".part", "wb") as out:
        curl = subprocess.Popen(read_command(key), stdout=subprocess.PIPE)
        unpack = subprocess.run(["zstd", "-dcq"], stdin=curl.stdout, stdout=out)
        curl.stdout.close()
        if curl.wait() != 0 or unpack.returncode != 0:
            fail(f"could not fetch {key} (curl {curl.returncode}, zstd {unpack.returncode})")
    os.replace(destination + ".part", destination)
    return key


def warm_key(runtime, name):
    """The warm parts depend on the translator, so each x86Sim version has its own; a store serves several at once."""
    return f"runtimes/{runtime}/warm/x86sim-{X86SIM_VERSION}/{name}"


def check_owned(directory):
    """The translation cache must belong to the user who boots (see fetch_and_extract): a cache unpacked by an older
    setup with the store builder's owner is refused rather than left to exhaust memory at boot."""
    if os.path.isdir(directory) and os.stat(directory).st_uid != os.getuid():
        fail(f"{directory} belongs to uid {os.stat(directory).st_uid}, not {os.getuid()}; x86Sim could not share its "
             f"translation image and the boot would run out of memory. Fix it with: chown -R {os.getuid()}:{os.getgid()} {directory}")


def current():
    return json.loads(store_get("current.json"))


def pack(source, paths_file, out):
    """tar of the listed paths under source, zstd compressed on every core. A listed file that is
    gone (one x86Sim made for a boot and removed) is reported and left out."""
    with open(paths_file) as f:
        paths = [line.rstrip("\n") for line in f if line.strip()]
    present = [p for p in paths if os.path.lexists(os.path.join(source, p))]
    if len(present) != len(paths):
        log(f"{out}: {len(paths) - len(present)} listed paths are gone and left out, e.g. {next(p for p in paths if p not in set(present))}")
        with open(paths_file, "w") as f:
            f.writelines(p + "\n" for p in present)
    with open(out, "wb") as f:
        tar = subprocess.Popen(["tar", "-C", source, "--no-recursion", "-T", paths_file, "-cf", "-"], stdout=subprocess.PIPE)
        zstd = subprocess.run(["zstd", "-T0", "-6", "-q", "-c"], stdin=tar.stdout, stdout=f)
        tar.stdout.close()
        if tar.wait() != 0 or zstd.returncode != 0:
            fail(f"packing {out} failed")
    log(f"{out}: {os.path.getsize(out) / 1e9:.2f} GB")


def pack_manifest(runtime, name, out):
    """packs/<name>.tar.zst and manifests/<name>.txt under out (runtimes/<runtime>/ of the store directory)."""
    extracted = os.path.join(runtime_dir(runtime), "extracted")
    root_rel = os.path.relpath(runtime_root(runtime), extracted)
    os.makedirs(os.path.join(out, "packs"), exist_ok=True)
    os.makedirs(os.path.join(out, "manifests"), exist_ok=True)
    with tempfile.NamedTemporaryFile("w", delete=False) as listing:
        listing.writelines(os.path.join(root_rel, p) + "\n" for p in read_manifest(runtime, name))
    pack(extracted, listing.name, os.path.join(out, "packs", f"{name}.tar.zst"))
    os.remove(listing.name)
    shutil.copy(os.path.join(manifests_dir(), runtime, f"{name}.txt"), os.path.join(out, "manifests", f"{name}.txt"))


def store_pack(device_name, manifests):
    """Only the named manifests' packs, for adding to or re-recording an app without rebuilding the whole store."""
    out_root = os.environ.get("STUPIDSIM_STORE_DIR") or fail("STUPIDSIM_STORE_DIR is not set (where to write the store's files)")
    runtime = device_runtime(device_dir(device_name))
    if is_lazy(runtime):
        fail("packs are built from the whole runtime; this machine fetches it on demand")
    if not manifests:
        fail("store pack needs --manifest NAME")
    for name in manifests:
        pack_manifest(runtime, name, os.path.join(out_root, "runtimes", runtime))


def store_build(device_name, manifests, warm_only=False):
    out_root = os.environ.get("STUPIDSIM_STORE_DIR") or fail("STUPIDSIM_STORE_DIR is not set (where to write the store's files)")
    device = device_dir(device_name)
    runtime = device_runtime(device)
    extracted = os.path.join(runtime_dir(runtime), "extracted")
    root = runtime_root(runtime)
    root_rel = os.path.relpath(root, extracted)
    out = os.path.join(out_root, "runtimes", runtime)
    os.makedirs(os.path.join(out, "packs"), exist_ok=True)
    os.makedirs(os.path.join(out, "manifests"), exist_ok=True)
    warm = os.path.join(out, "warm", f"x86sim-{X86SIM_VERSION}")
    os.makedirs(warm, exist_ok=True)
    if is_booted(device):
        fail(f"shut {device_name} down first (stupidsim-linux shutdown --device {device_name}); a running device's data is not consistent")

    # The skeleton and the packs are the runtime's own files and do not depend on x86Sim: an x86Sim upgrade needs
    # only the warm parts (store warm), and leaves the published packs alone.
    if not warm_only:
        with tempfile.NamedTemporaryFile("w", delete=False) as listing:
            for directory, dirs, files in os.walk(extracted):
                rel = os.path.relpath(directory, extracted)
                listing.write(rel + "\n")
                for name in dirs + files:
                    path = os.path.join(directory, name)
                    inside = os.path.relpath(path, extracted)
                    if os.path.islink(path) or (name in files and not inside.startswith(root_rel + "/")):
                        listing.write(inside + "\n")
        pack(extracted, listing.name, os.path.join(out, "skeleton.tar.zst"))
        os.remove(listing.name)

        for name in manifests:
            pack_manifest(runtime, name, out)

    build = runtime.split("-")[2]
    cache = os.path.join(x86sim_cache(), f"jc-{build}")
    with tempfile.NamedTemporaryFile("w", delete=False) as listing:
        # All of it but locks: the AOT image, its work directory (installing an app adds to the
        # image from it) and each process's live translations.
        for directory, _, files in os.walk(cache):
            rel = os.path.relpath(directory, x86sim_cache())
            listing.write(rel + "\n")
            listing.writelines(os.path.join(rel, n) + "\n" for n in files if n != "lock" and not n.endswith(".lock"))
    pack(x86sim_cache(), listing.name, os.path.join(warm, "jitcache.tar.zst"))
    os.remove(listing.name)

    with tempfile.NamedTemporaryFile("w", delete=False) as listing:
        for directory, dirs, files in os.walk(device):
            rel = os.path.relpath(directory, os.path.dirname(device))
            # Sockets do not survive a copy; the next boot makes them again. os_log's uuidtext
            # tables hold the device's old path in a form device-repath.py cannot rewrite, and the
            # device rebuilds them.
            if "/data/var/db/uuidtext" in "/" + rel:
                continue
            listing.writelines(os.path.join(rel, n) + "\n" for n in files if not n.endswith(".sock"))
            listing.writelines(os.path.join(rel, n) + "\n" for n in dirs if os.path.islink(os.path.join(directory, n)))
            listing.write(rel + "\n")
    pack(os.path.dirname(device), listing.name, os.path.join(warm, "device.tar.zst"))
    os.remove(listing.name)
    with open(os.path.join(warm, "device.json"), "w") as f:
        json.dump({"path": device, "directory": os.path.basename(device)}, f)
    # current.json (the default runtime) is not written: changing it is a decision of its own (see
    # docs/runbooks/new-ios-version.md), and its "x86sim" field must keep naming what older stupidsim versions read.
    log(f"store files for {runtime} and x86Sim {X86SIM_VERSION} are in {out_root}; upload them with: stupidsim-linux store publish")


# ---------------------------------------------------------------- the lazy runtime: building it

# A unit is what one fetch brings: the files of the innermost bundle a file is in (each .lproj on its own, so a
# language nobody uses is never fetched), or of its directory outside bundles, in path order, split at UNIT_MAX.
BUNDLE_SUFFIXES = (".framework", ".bundle", ".app", ".appex", ".xpc", ".plugin", ".axbundle", ".lproj")
UNIT_MAX = 32 << 20     # uncompressed bytes per unit; a single larger file is a unit of its own
BLOB_MAX = 4 << 30      # R2 takes at most 5 GiB in one PUT
# Bundle metadata, read for every bundle when a new machine's device first boots: LaunchServices registers each app,
# extension and framework again (the device template's database names another path), reading its Info.plist and its
# InfoPlist strings in every language, and the App Intents metadata. On iOS 27.2 that was 26,642 units fetched
# one by one (6 minutes from a local disk); all of it is 79,399 files, 46 MB, so it is fetched up front as a pack.
METADATA_NAMES = re.compile(r"^(Info\.plist|InfoPlist.*\.(strings|loctable)|.*\.intentdefinition|AppShortcuts\.strings|"
                            r"extract\..*data|version\.json)$")


def unit_key(rel):
    parts = rel.split("/")[:-1]
    for i in range(len(parts) - 1, -1, -1):
        if parts[i].endswith(BUNDLE_SUFFIXES):
            return "/".join(parts[:i + 1])
    return "/".join(parts)


def lazy_entries(extracted):
    """Every directory, symlink and regular file of the runtime in path order, without x86Sim's own per-device files."""
    for directory, dirs, files in os.walk(extracted):
        dirs[:] = sorted(d for d in dirs if not d.startswith(".x86sim-"))
        rel_dir = os.path.relpath(directory, extracted)
        rel_dir = "" if rel_dir == "." else rel_dir
        for name in sorted(dirs + files):
            path = os.path.join(directory, name)
            st = os.lstat(path)
            rel = os.path.join(rel_dir, name) if rel_dir else name
            if stat.S_ISLNK(st.st_mode):
                yield rel, "l", st, os.readlink(path)
            elif stat.S_ISDIR(st.st_mode):
                yield rel, "d", st, None
            elif stat.S_ISREG(st.st_mode):
                yield rel, "f", st, None


def compress_unit(extracted, paths):
    """One unit as a zstd-compressed tar (zstd keeps a checksum of the content, so a damaged range fails to unpack)."""
    import io
    import tarfile
    raw = io.BytesIO()
    with tarfile.open(fileobj=raw, mode="w", format=tarfile.GNU_FORMAT) as tar:
        for rel in paths:
            info = tar.gettarinfo(os.path.join(extracted, rel), arcname=rel)
            info.uid = info.gid = 0
            info.uname = info.gname = ""
            with open(os.path.join(extracted, rel), "rb") as f:
                tar.addfile(info, f)
    out = subprocess.run(["zstd", "-q", "-10", "-c"], input=raw.getvalue(), stdout=subprocess.PIPE, check=True)
    return out.stdout


def store_lazy(device_name):
    """Writes runtimes/<runtime>/lazy/: the index (a SQLite database) and the blobs, from the whole runtime."""
    import sqlite3
    out_root = os.environ.get("STUPIDSIM_STORE_DIR") or fail("STUPIDSIM_STORE_DIR is not set (where to write the store's files)")
    runtime = device_runtime(device_dir(device_name))
    extracted = os.path.join(runtime_dir(runtime), "extracted")
    if os.path.ismount(extracted):
        fail(f"{extracted} is a lazy mount; build the lazy store from a machine with the whole runtime")
    out = os.path.join(out_root, "runtimes", runtime, "lazy")
    shutil.rmtree(out, ignore_errors=True)
    os.makedirs(out)
    started = time.time()

    db_path = os.path.join(out, "index.sqlite")
    db = sqlite3.connect(db_path)
    db.executescript("""
        CREATE TABLE entries (parent TEXT NOT NULL, name TEXT NOT NULL, kind TEXT NOT NULL, mode INTEGER NOT NULL,
            size INTEGER NOT NULL, mtime_ns INTEGER NOT NULL, unit INTEGER, target TEXT, PRIMARY KEY (parent, name))
            WITHOUT ROWID;
        CREATE TABLE units (id INTEGER PRIMARY KEY, blob TEXT NOT NULL, offset INTEGER NOT NULL, length INTEGER NOT NULL,
            files INTEGER NOT NULL, size INTEGER NOT NULL, key TEXT NOT NULL);
        CREATE TABLE meta (key TEXT PRIMARY KEY, value TEXT NOT NULL);
    """)
    rows, units = [], []  # units: [key, [paths], size]
    for rel, kind, st, target in lazy_entries(extracted):
        parent, name = os.path.split(rel)
        unit = None
        if kind == "f":
            key = unit_key(rel)
            if not units or units[-1][0] != key or (units[-1][2] and units[-1][2] + st.st_size > UNIT_MAX):
                units.append([key, [], 0])
            units[-1][1].append(rel)
            units[-1][2] += st.st_size
            unit = len(units) - 1
        rows.append((parent, name, kind, stat.S_IMODE(st.st_mode), st.st_size if kind == "f" else 0, st.st_mtime_ns, unit, target))
    db.executemany("INSERT INTO entries VALUES (?, ?, ?, ?, ?, ?, ?, ?)", rows)
    files = sum(1 for r in rows if r[2] == "f")
    packs = os.path.join(out_root, "runtimes", runtime, "packs")
    os.makedirs(packs, exist_ok=True)
    with tempfile.NamedTemporaryFile("w", delete=False) as listing:
        listing.writelines(os.path.join(r[0], r[1]) + "\n" for r in rows if r[2] == "f" and METADATA_NAMES.match(r[1]))
    pack(extracted, listing.name, os.path.join(packs, "metadata.tar.zst"))
    os.remove(listing.name)
    log(f"indexed {len(rows)} entries, {files} files in {len(units)} units ({time.time() - started:.0f} s)")

    blob_index, blob, blob_size, total = 0, None, 0, 0
    def open_blob():
        nonlocal blob, blob_size, blob_index
        if blob:
            blob.close()
            blob_index += 1
        blob, blob_size = open(os.path.join(out, f"blob-{blob_index:03d}"), "wb"), 0
    open_blob()
    batch = 4 * (os.cpu_count() or 4)
    with concurrent.futures.ThreadPoolExecutor(max_workers=os.cpu_count()) as pool:
        for first in range(0, len(units), batch):
            chunk = units[first:first + batch]
            for i, data in enumerate(pool.map(lambda u: compress_unit(extracted, u[1]), chunk)):
                if blob_size and blob_size + len(data) > BLOB_MAX:
                    open_blob()
                key, paths, size = chunk[i]
                db.execute("INSERT INTO units VALUES (?, ?, ?, ?, ?, ?, ?)",
                           (first + i, f"blob-{blob_index:03d}", blob_size, len(data), len(paths), size, key))
                blob.write(data)
                blob_size += len(data)
                total += len(data)
            if first // batch % 50 == 0:
                log(f"  {first + len(chunk)}/{len(units)} units, {total / 1e9:.2f} GB ({time.time() - started:.0f} s)")
    blob.close()
    db.executemany("INSERT INTO meta VALUES (?, ?)", [("runtime", runtime), ("format", "1")])
    db.commit()
    db.execute("VACUUM")
    db.close()
    subprocess.run(["zstd", "-q", "-19", "-T0", "--rm", "-f", db_path], check=True)
    log(f"{out}: {blob_index + 1} blobs, {total / 1e9:.2f} GB, index {os.path.getsize(db_path + '.zst') / 1e6:.1f} MB "
        f"({time.time() - started:.0f} s); upload with: stupidsim-linux store publish")


# ---------------------------------------------------------------- the lazy runtime: serving it

def layers_dir(runtime):
    return os.path.join(runtime_dir(runtime), "layers")


def is_lazy(runtime):
    return os.path.isdir(layers_dir(runtime))


class FuseBinding:
    """The parts of libfuse 3's high-level API that a read-only file system needs, through ctypes (x86_64 Linux).
    Struct layouts are libfuse 3.14's (Ubuntu 24.04), which keeps them stable across 3.x."""

    def __init__(self):
        import ctypes
        import ctypes.util
        self.c = ctypes
        name = ctypes.util.find_library("fuse3") or "libfuse3.so.3"
        try:
            self.lib = ctypes.CDLL(name, use_errno=True)
        except OSError as error:
            fail(f"libfuse 3 is missing ({error}); install it with: apt-get install -y fuse3")
        c = ctypes

        class Timespec(c.Structure):
            _fields_ = [("tv_sec", c.c_long), ("tv_nsec", c.c_long)]

        class Stat(c.Structure):
            _fields_ = [("st_dev", c.c_uint64), ("st_ino", c.c_uint64), ("st_nlink", c.c_uint64), ("st_mode", c.c_uint32),
                        ("st_uid", c.c_uint32), ("st_gid", c.c_uint32), ("pad0", c.c_int32), ("st_rdev", c.c_uint64),
                        ("st_size", c.c_int64), ("st_blksize", c.c_int64), ("st_blocks", c.c_int64), ("st_atim", Timespec),
                        ("st_mtim", Timespec), ("st_ctim", Timespec), ("reserved", c.c_int64 * 3)]

        self.Stat = Stat
        self.fill_dir_t = c.CFUNCTYPE(c.c_int, c.c_void_p, c.c_char_p, c.c_void_p, c.c_int64, c.c_int)
        self.GETATTR = c.CFUNCTYPE(c.c_int, c.c_char_p, c.POINTER(Stat), c.c_void_p)
        self.READLINK = c.CFUNCTYPE(c.c_int, c.c_char_p, c.POINTER(c.c_char), c.c_size_t)
        self.OPEN = c.CFUNCTYPE(c.c_int, c.c_char_p, c.c_void_p)
        self.READ = c.CFUNCTYPE(c.c_int, c.c_char_p, c.POINTER(c.c_char), c.c_size_t, c.c_int64, c.c_void_p)
        self.READDIR = c.CFUNCTYPE(c.c_int, c.c_char_p, c.c_void_p, self.fill_dir_t, c.c_int64, c.c_void_p, c.c_int)
        # struct fuse_operations, in order; only the ones set are typed
        names = ["getattr", "readlink", "mknod", "mkdir", "unlink", "rmdir", "symlink", "rename", "link", "chmod", "chown",
                 "truncate", "open", "read", "write", "statfs", "flush", "release", "fsync", "setxattr", "getxattr",
                 "listxattr", "removexattr", "opendir", "readdir", "releasedir", "fsyncdir", "init", "destroy", "access",
                 "create", "lock", "utimens", "bmap", "ioctl", "poll", "write_buf", "read_buf", "flock", "fallocate",
                 "copy_file_range", "lseek"]
        typed = {"getattr": self.GETATTR, "readlink": self.READLINK, "open": self.OPEN, "read": self.READ, "readdir": self.READDIR}

        class Operations(c.Structure):
            _fields_ = [(n, typed.get(n, c.c_void_p)) for n in names]

        self.Operations = Operations
        self.lib.fuse_main_real.argtypes = [c.c_int, c.POINTER(c.c_char_p), c.POINTER(Operations), c.c_size_t, c.c_void_p]
        self.lib.fuse_main_real.restype = c.c_int

    def main(self, mountpoint, options, handlers):
        c = self.c
        ops = self.Operations()
        keep = []
        for name, kind in (("getattr", self.GETATTR), ("readlink", self.READLINK), ("open", self.OPEN),
                           ("read", self.READ), ("readdir", self.READDIR)):
            fn = kind(handlers[name])
            keep.append(fn)
            setattr(ops, name, fn)
        args = [b"stupidsim-lazy", mountpoint.encode(), b"-f", b"-o", options.encode()]
        argv = (c.c_char_p * len(args))(*args)
        return self.lib.fuse_main_real(len(args), argv, c.byref(ops), c.sizeof(ops), None)


class LazyRuntime:
    """Answers the runtime's metadata from the index and serves file contents from layers/fetched, fetching a
    file's unit from the store on its first open. Called on libfuse's threads."""

    def __init__(self, runtime, uid, gid):
        import collections
        import threading
        self.runtime, self.uid, self.gid = runtime, uid, gid
        self.layers = layers_dir(runtime)
        self.fetched = os.path.join(self.layers, "fetched")
        self.index_path = os.path.join(self.layers, "index.sqlite")
        self.local = threading.local()
        self.fds, self.fds_lock = {}, threading.Lock()
        self.unit_locks = collections.defaultdict(threading.Lock)
        self.units_lock = threading.Lock()
        self.log_lock = threading.Lock()
        self.fetched_units = set()
        # Every file opened through this server, once each, in order: a trace (see trace_begin) that needs no whole runtime.
        self.opened, self.opened_file = set(), open(os.path.join(self.layers, "opened.txt"), "a", buffering=1)
        # STUPIDSIM_LAZY_STATS=1: every 30 s, log how many calls of each kind the server answered and their time
        self.stats = {} if os.environ.get("STUPIDSIM_LAZY_STATS") else None

    def db(self):
        import sqlite3
        if not hasattr(self.local, "db"):
            self.local.db = sqlite3.connect(f"file:{self.index_path}?mode=ro", uri=True, check_same_thread=False)
        return self.local.db

    def note(self, message):
        with self.log_lock:
            print(f"{time.strftime('%H:%M:%S')} {message}", flush=True)

    def entry(self, path):
        rel = path.decode().lstrip("/")
        if not rel:
            return ("d", 0o755, 0, 0, None, None)
        parent, name = os.path.split(rel)
        return self.db().execute("SELECT kind, mode, size, mtime_ns, unit, target FROM entries WHERE parent = ? AND name = ?",
                                 (parent, name)).fetchone()

    def guarded(self, fn):
        stats = self.stats

        def call(*args):
            started = time.perf_counter()
            try:
                return fn(*args)
            except OSError as error:
                return -(error.errno or errno.EIO)
            except Exception as error:  # an exception must not cross into C; report it and fail the call
                self.note(f"FAILED {fn.__name__} {args[0]!r}: {error!r}")
                return -errno.EIO
            finally:
                if stats is not None:
                    entry = stats.setdefault(fn.__name__, [0, 0.0])
                    entry[0] += 1
                    entry[1] += time.perf_counter() - started
        call.__name__ = fn.__name__
        return call

    def getattr(self, path, st, _fi):
        e = self.entry(path)
        if not e:
            return -errno.ENOENT
        kind, mode, size, mtime_ns, _, target = e
        s = st.contents
        self.c.memset(st, 0, self.c.sizeof(s))
        s.st_mode = mode | {"d": stat.S_IFDIR, "f": stat.S_IFREG, "l": stat.S_IFLNK}[kind]
        s.st_nlink = 2 if kind == "d" else 1
        s.st_uid, s.st_gid = self.uid, self.gid
        s.st_size = len(target.encode()) if kind == "l" else size
        s.st_blksize = 4096
        s.st_blocks = (s.st_size + 511) // 512
        for t in (s.st_atim, s.st_mtim, s.st_ctim):
            t.tv_sec, t.tv_nsec = divmod(mtime_ns, 10**9)
        return 0

    def readlink(self, path, buf, size):
        e = self.entry(path)
        if not e:
            return -errno.ENOENT
        if e[0] != "l":
            return -errno.EINVAL
        data = e[5].encode()[:size - 1] + b"\0"
        self.c.memmove(buf, data, len(data))
        return 0

    def readdir(self, path, buf, filler, _offset, _fi, _flags):
        rel = path.decode().lstrip("/")
        e = self.entry(path)
        if not e:
            return -errno.ENOENT
        if e[0] != "d":
            return -errno.ENOTDIR
        for name in (".", ".."):
            filler(buf, name.encode(), None, 0, 0)
        for (name,) in self.db().execute("SELECT name FROM entries WHERE parent = ?", (rel,)):
            if filler(buf, name.encode(), None, 0, 0):
                break
        return 0

    def open(self, path, _fi):
        e = self.entry(path)
        if not e:
            return -errno.ENOENT
        if e[0] != "f":
            return -errno.EISDIR if e[0] == "d" else -errno.ELOOP
        rel = path.decode().lstrip("/")
        with self.log_lock:
            if rel not in self.opened:
                self.opened.add(rel)
                self.opened_file.write(rel + "\n")
        local = os.path.join(self.fetched, rel)
        if not os.path.exists(local):
            self.fetch(e[4], rel)
        if os.path.getsize(local) != e[2]:
            self.note(f"FAILED {rel}: fetched {os.path.getsize(local)} bytes, the index says {e[2]}")
            return -errno.EIO
        return 0

    def read(self, path, buf, size, offset, _fi):
        rel = path.decode().lstrip("/")
        with self.fds_lock:
            fd = self.fds.get(rel)
            if fd is None:
                fd = self.fds[rel] = os.open(os.path.join(self.fetched, rel), os.O_RDONLY | os.O_CLOEXEC)
        data = os.pread(fd, size, offset)
        self.c.memmove(buf, data, len(data))
        return len(data)

    def fetch(self, unit, wanted):
        """Fetches one unit into layers/fetched. Fails loudly: the open fails with EIO and the reason is logged."""
        with self.unit_locks[unit]:
            if unit in self.fetched_units and os.path.exists(os.path.join(self.fetched, wanted)):
                return
            blob, offset, length, files, size, key = self.db().execute(
                "SELECT blob, offset, length, files, size, key FROM units WHERE id = ?", (unit,)).fetchone()
            started = time.time()
            scratch = tempfile.mkdtemp(dir=os.path.join(self.layers, "fetching"))
            try:
                command = read_command(f"runtimes/{self.runtime}/lazy/{blob}")
                command = command[:-1] + ["-r", f"{offset}-{offset + length - 1}", command[-1]]
                curl = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                unpack = subprocess.run(f"zstd -dcq | tar -x --no-same-owner -C '{scratch}'", shell=True, stdin=curl.stdout,
                                        stderr=subprocess.PIPE)
                curl.stdout.close()
                curl_error = curl.stderr.read().decode().strip()
                if curl.wait() != 0 or unpack.returncode != 0:
                    raise OSError(errno.EIO, f"curl {curl.returncode} {curl_error!r}, unpack {unpack.returncode} "
                                             f"{unpack.stderr.decode().strip()!r}")
                count = 0
                for directory, _, names in os.walk(scratch):
                    for name in names:
                        source = os.path.join(directory, name)
                        target = os.path.join(self.fetched, os.path.relpath(source, scratch))
                        os.makedirs(os.path.dirname(target), exist_ok=True)
                        os.replace(source, target)
                        count += 1
                if count != files:
                    raise OSError(errno.EIO, f"the unit unpacked to {count} files, the index lists {files}")
            except OSError as error:
                self.note(f"FAILED fetching {key} (unit {unit}, {blob} {offset}+{length}) for {wanted}: {error.strerror or error}")
                raise OSError(errno.EIO, "fetch failed")
            finally:
                shutil.rmtree(scratch, ignore_errors=True)
            self.fetched_units.add(unit)
            self.note(f"fetched {key or '/'}: {files} files, {size / 1e6:.1f} MB ({length / 1e6:.1f} MB compressed) "
                      f"in {time.time() - started:.2f} s, for {wanted}")


def lazy_serve(runtime, uid, gid):
    """The FUSE server at layers/lazy, run in the foreground (mount starts it in the background)."""
    import ctypes
    import resource
    fuse = FuseBinding()
    fs = LazyRuntime(runtime, uid, gid)
    fs.c = ctypes
    os.makedirs(fs.fetched, exist_ok=True)
    shutil.rmtree(os.path.join(fs.layers, "fetching"), ignore_errors=True)
    os.makedirs(os.path.join(fs.layers, "fetching"))
    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    resource.setrlimit(resource.RLIMIT_NOFILE, (hard, hard))
    fs.note(f"serving {runtime} at {os.path.join(fs.layers, 'lazy')}")
    if fs.stats is not None:
        import threading

        def report():
            while True:
                time.sleep(30)
                fs.note("stats " + ", ".join(f"{k} {n} in {t:.1f} s" for k, (n, t) in sorted(fs.stats.items())))
        threading.Thread(target=report, daemon=True).start()
    handlers = {name: fs.guarded(getattr(fs, name)) for name in ("getattr", "readlink", "open", "read", "readdir")}
    # The runtime never changes, so the kernel may keep names, attributes, missing names and pages for good.
    options = ("ro,allow_other,default_permissions,kernel_cache,entry_timeout=86400,attr_timeout=86400,"
               "negative_timeout=86400,fsname=stupidsim-lazy,subtype=stupidsim")
    status = fuse.main(os.path.join(fs.layers, "lazy"), options, handlers)
    fs.note(f"stopped ({status})")
    sys.exit(status)


def lazy_paths(runtime):
    layers = layers_dir(runtime)
    return {n: os.path.join(layers, n) for n in ("local", "lazy", "upper", "work")} | {
        "extracted": os.path.join(runtime_dir(runtime), "extracted"), "log": os.path.join(layers, "lazy.log")}


def darling_running():
    """x86Sim's Darling copies the mount table when its server starts; a mount made after that is not visible inside."""
    return subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "darlingserver"], stdout=subprocess.DEVNULL).returncode == 0


def mount_lazy(runtime):
    p = lazy_paths(runtime)
    if os.path.ismount(p["extracted"]):
        return
    if os.geteuid() != 0:
        fail(f"mounting the lazy runtime at {p['extracted']} needs root (an overlay and a FUSE file system); "
             f"run: sudo stupidsim-linux mount")
    if darling_running():
        fail("x86Sim's darlingserver is already running, so it would not see the runtime mounted now; "
             "shut the device down (stupidsim-linux shutdown) and try again")
    if not os.path.exists(os.path.join(layers_dir(runtime), "index.sqlite")):
        fail(f"{layers_dir(runtime)} has no index.sqlite; run stupidsim-linux setup again")
    for name in ("lazy", "upper", "work", "extracted"):
        os.makedirs(p[name], exist_ok=True)
    if not os.path.ismount(p["lazy"]):
        owner = os.stat(p["local"])
        with open(p["log"], "a") as log_file:
            subprocess.Popen([sys.executable, os.path.realpath(__file__), "lazy-serve", runtime,
                              "--uid", str(owner.st_uid), "--gid", str(owner.st_gid)],
                             stdin=subprocess.DEVNULL, stdout=log_file, stderr=subprocess.STDOUT, start_new_session=True)
        for _ in range(100):
            if os.path.ismount(p["lazy"]):
                break
            time.sleep(0.1)
        else:
            fail(f"the lazy file system did not come up at {p['lazy']}; see {p['log']}")
    subprocess.run(["mount", "-t", "overlay", "stupidsim-runtime", "-o",
                    f"lowerdir={p['local']}:{p['lazy']},upperdir={p['upper']},workdir={p['work']}", p["extracted"]], check=True)
    log(f"mounted the lazy runtime at {p['extracted']} (fetches are logged in {p['log']})")


def unmount_lazy(runtime):
    p = lazy_paths(runtime)
    for name in ("extracted", "lazy"):
        if os.path.ismount(p[name]):
            subprocess.run(["umount", p[name]], check=True)
            log(f"unmounted {p[name]}")


def store_publish():
    out_root = os.environ.get("STUPIDSIM_STORE_DIR") or fail("STUPIDSIM_STORE_DIR is not set")
    keys = []
    for directory, _, files in os.walk(out_root):
        keys += [os.path.relpath(os.path.join(directory, n), out_root) for n in files]
    for key in sorted(keys, key=lambda k: k == "current.json"):  # current.json last, once its files are there
        size = os.path.getsize(os.path.join(out_root, key))
        subprocess.run(curl_store(key, ["-T", os.path.join(out_root, key)]), check=True)
        log(f"uploaded {key} ({size / 1e9:.2f} GB)")


def presign(key, hours):
    """An AWS SigV4 query-string signature, which R2 accepts, made with the standard library."""
    import datetime
    import hmac
    url, key_id, secret = store_env()
    parsed = urllib.parse.urlparse(f"{url}/{urllib.parse.quote(key)}")
    now = datetime.datetime.now(datetime.timezone.utc)
    stamp, day = now.strftime("%Y%m%dT%H%M%SZ"), now.strftime("%Y%m%d")
    scope = f"{day}/auto/s3/aws4_request"
    query = urllib.parse.urlencode(sorted({
        "X-Amz-Algorithm": "AWS4-HMAC-SHA256", "X-Amz-Credential": f"{key_id}/{scope}", "X-Amz-Date": stamp,
        "X-Amz-Expires": str(hours * 3600), "X-Amz-SignedHeaders": "host"}.items()), quote_via=urllib.parse.quote)
    request = "\n".join(["GET", parsed.path, query, f"host:{parsed.netloc}\n", "host", "UNSIGNED-PAYLOAD"])
    to_sign = "\n".join(["AWS4-HMAC-SHA256", stamp, scope, hashlib.sha256(request.encode()).hexdigest()])
    signing = f"AWS4{secret}".encode()
    for part in (day, "auto", "s3", "aws4_request"):
        signing = hmac.new(signing, part.encode(), hashlib.sha256).digest()
    signature = hmac.new(signing, to_sign.encode(), hashlib.sha256).hexdigest()
    print(f"{parsed.scheme}://{parsed.netloc}{parsed.path}?{query}&X-Amz-Signature={signature}")


# ---------------------------------------------------------------- setup

def ensure_tools():
    missing = [tool for tool in ("curl", "tar", "zstd") if not shutil.which(tool)]
    if missing and os.geteuid() == 0 and shutil.which("apt-get"):
        log(f"installing {' '.join(missing)}")
        # A fresh cloud VM's package lists are stale; install fails until they are refreshed.
        subprocess.run(["apt-get", "update", "-qq"], check=True, stdout=subprocess.DEVNULL)
        subprocess.run(["apt-get", "install", "-y", "-qq"] + missing, check=True, stdout=subprocess.DEVNULL)
        missing = [tool for tool in missing if not shutil.which(tool)]
    if missing:
        fail(f"{' '.join(missing)} {'is' if len(missing) == 1 else 'are'} missing")


def apply_features(device, preset):
    """x86Sim's feature presets turn off parts of the system a test device rarely needs, each with
    its memory cost: lean drops the wallpaper, Spotlight, Siri and widgets. Wallet costs about
    190 MB on every boot and is off too unless the preset is full. A 16 GB cloud VM ran out of
    memory booting with everything on (x86Sim 0.3.0)."""
    run_x86sim(["aot", "--device", device, "features", "preset", preset], capture=True)
    if preset != "full":
        run_x86sim(["aot", "--device", device, "features", "set", "wallet", "off"], capture=True)


def setup(apps, name, no_boot, metal, runtime=None, features="lean"):
    started = time.time()
    ensure_tools()
    runtime = runtime or current()["runtime"]
    try:
        template = json.loads(object_text(warm_key(runtime, "device.json")))
    except subprocess.CalledProcessError:
        fail(f"the store has no parts for x86Sim {X86SIM_VERSION} on {runtime} ({warm_key(runtime, '')}); it needs "
             f"`stupidsim-linux store build` with this x86Sim (docs/runbooks/new-ios-version.md)")
    install_x86sim()
    ensure_darling()
    run_x86sim(["version"], capture=True)  # copies x86Sim's payload into its data directory once

    base = f"runtimes/{runtime}"
    rdir = runtime_dir(runtime)
    device = device_dir(name)
    jobs = []
    marker = os.path.join(rdir, ".stupidsim-parts")
    have = set(open(marker).read().split()) if os.path.exists(marker) else set()
    parts = ["skeleton", "base", "metadata", "index"] + list(apps)
    warm_part = f"jitcache-x86sim-{X86SIM_VERSION}"
    jitcache = os.path.join(x86sim_cache(), f"jc-{runtime.split('-')[2]}")
    # The fetched parts are the overlay's top layer (layers/local); the rest of the runtime is fetched on first use.
    extracted, local = os.path.join(rdir, "extracted"), os.path.join(layers_dir(runtime), "local")
    if os.path.isdir(extracted) and not os.path.ismount(extracted) and os.listdir(extracted):
        fail(f"{extracted} holds a runtime set up before runtimes were fetched on demand; remove {rdir} and set up again")
    if os.path.ismount(extracted) and set(parts) - have:
        fail(f"the runtime is mounted, and its layers cannot change while it is; shut the device down, run "
             f"stupidsim-linux unmount, and set up again")
    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
        for part in parts:
            if part in have:
                continue
            if part == "index":
                jobs.append(pool.submit(fetch_file, f"{base}/lazy/index.sqlite.zst", os.path.join(layers_dir(runtime), "index.sqlite")))
                continue
            key = f"{base}/skeleton.tar.zst" if part == "skeleton" else f"{base}/packs/{part}.tar.zst"
            jobs.append(pool.submit(fetch_and_extract, key, local))
        if warm_part not in have:
            # Another x86Sim's cache (or one from before caches were versioned) is replaced, not merged into.
            shutil.rmtree(jitcache, ignore_errors=True)
            jobs.append(pool.submit(fetch_and_extract, warm_key(runtime, "jitcache.tar.zst"), x86sim_cache()))
        fresh_device = not os.path.isdir(device)
        if fresh_device:
            scratch = tempfile.mkdtemp(dir=os.path.join(x86sim_data(), "var") if os.path.isdir(os.path.join(x86sim_data(), "var")) else None)
            jobs.append(pool.submit(fetch_and_extract, warm_key(runtime, "device.tar.zst"), scratch))
        for job in concurrent.futures.as_completed(jobs):
            log(f"fetched {job.result()} ({time.time() - started:.0f} s)")
    with open(marker, "w") as f:
        f.write(" ".join(sorted((have - {p for p in have if p.startswith("jitcache-x86sim-")}) | set(parts) | {warm_part})))
    check_owned(jitcache)
    link = os.path.join(rdir, "RuntimeRoot")
    if not os.path.islink(link):
        # Into the mount point; the path inside is the same in layers/local, where the skeleton is.
        os.symlink(os.path.join("extracted", os.path.relpath(runtime_root_unchecked(local), local)), link)
    os.makedirs(extracted, exist_ok=True)

    if fresh_device:
        os.makedirs(os.path.dirname(device), exist_ok=True)
        os.replace(os.path.join(scratch, template["directory"]), device)
        shutil.rmtree(scratch, ignore_errors=True)
        with open(os.path.join(device, "name"), "w") as f:
            f.write(name + "\n")
        # The device's stores keep its absolute path; x86Sim's own tool moves them (device-a64.py does the same for clones).
        repath = run_x86sim(["shell", "-c", f'python3 cli/libexec/arm64/device-repath.py "{device}" "{template["path"]}"'], capture=True, check=False)
        if repath.returncode != 0:
            fail(f"moving the device template's paths failed: {repath.stdout[-1500:]}")
    apply_features(device, features)
    log(f"set up in {time.time() - started:.0f} s")
    if not no_boot:
        boot(name, metal)
        udid = next((line.split("=", 1)[1] for line in open(os.path.join(device, "sim.env")) if line.startswith("SIMULATOR_UDID=")), "?")
        log(f"ready: device {name}, UDID {udid}, {time.time() - started:.0f} s after setup started")


def runtime_root_unchecked(top):
    runtimes = os.path.join(top, RUNTIME_ROOT_PREFIX)
    for name in sorted(os.listdir(runtimes)):
        candidate = os.path.join(runtimes, name, "Contents/Resources/RuntimeRoot")
        if os.path.isdir(candidate):
            return candidate
    fail(f"the skeleton has no RuntimeRoot under {runtimes}")


def object_text(key):
    return store_get(key).decode()


def main():
    parser = argparse.ArgumentParser(prog="stupidsim-linux", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    p = commands.add_parser("setup")
    p.add_argument("--app", action="append", default=[], help="an app manifest to fetch as well (repeatable)")
    p.add_argument("--device", default=DEFAULT_DEVICE)
    p.add_argument("--no-boot", action="store_true")
    p.add_argument("--metal", choices=["auto", "gpu", "lavapipe", "software"], default="auto")
    p.add_argument("--runtime", help="a runtime in the store, such as ios-27.2-24B8117-arm64 (default: current.json's)")
    p.add_argument("--features", choices=["full", "lean", "minimal"], default="lean",
                   help="x86Sim's feature preset for the device; lean and minimal also turn Wallet off (default: lean)")
    p = commands.add_parser("boot")
    p.add_argument("--device", default=DEFAULT_DEVICE)
    p.add_argument("--metal", choices=["auto", "gpu", "lavapipe", "software"], default="auto")
    p = commands.add_parser("shutdown")
    p.add_argument("--device", default=DEFAULT_DEVICE)
    for command in ("mount", "unmount"):
        p = commands.add_parser(command)
        p.add_argument("--device", default=DEFAULT_DEVICE)
    p = commands.add_parser("lazy-serve", help=argparse.SUPPRESS)
    p.add_argument("runtime")
    p.add_argument("--uid", type=int, default=os.getuid())
    p.add_argument("--gid", type=int, default=os.getgid())
    p = commands.add_parser("trace")
    p.add_argument("phase", choices=["begin", "end"])
    p.add_argument("name", nargs="?")
    p.add_argument("--device", default=DEFAULT_DEVICE)
    p.add_argument("--base", help="leave out the files of this manifest (normally base)")
    p = commands.add_parser("store")
    p.add_argument("action", choices=["build", "warm", "lazy", "pack", "publish", "presign"])
    p.add_argument("key", nargs="?")
    p.add_argument("--device", default=DEFAULT_DEVICE)
    p.add_argument("--manifest", action="append", default=[])
    p.add_argument("--hours", type=int, default=6)
    a = parser.parse_args()

    if a.command == "setup":
        setup(a.app, a.device, a.no_boot, a.metal, a.runtime, a.features)
    elif a.command == "boot":
        boot(a.device, a.metal)
    elif a.command == "shutdown":
        shutdown(a.device)
    elif a.command in ("mount", "unmount"):
        runtime = device_runtime(device_dir(a.device))
        if not is_lazy(runtime):
            fail(f"{runtime} is not set up to be fetched on demand (no {layers_dir(runtime)})")
        (mount_lazy if a.command == "mount" else unmount_lazy)(runtime)
    elif a.command == "lazy-serve":
        lazy_serve(a.runtime, a.uid, a.gid)
    elif a.command == "trace":
        if a.phase == "begin":
            trace_begin(a.device)
        else:
            if not a.name:
                fail("trace end needs the manifest's name")
            trace_end(a.name, a.device, a.base)
    elif a.action == "build":
        store_build(a.device, a.manifest or ["base"])
    elif a.action == "warm":
        store_build(a.device, [], warm_only=True)
    elif a.action == "lazy":
        store_lazy(a.device)
    elif a.action == "pack":
        store_pack(a.device, a.manifest)
    elif a.action == "publish":
        store_publish()
    else:
        if not a.key:
            fail("store presign needs the object's key")
        presign(a.key, a.hours)


if __name__ == "__main__":
    main()
