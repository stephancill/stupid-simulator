diff --git a/linux/arm64jit/jit.cpp b/linux/arm64jit/jit.cpp
index d24c515..fd8d951 100644
--- a/linux/arm64jit/jit.cpp
+++ b/linux/arm64jit/jit.cpp
@@ -972,6 +972,20 @@ void GuestThread::ensure_stack(u64 requested) {
     stack_base = (u64)stk + kGuestStackGuard;
     stack_size = want;
 }
+u64 GuestThread::map_stack(u64 size) {
+    void *stk = mmap(nullptr, kGuestStackGuard + size, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+    if (stk == MAP_FAILED) return 0;
+    if (mprotect((char *)stk + kGuestStackGuard, size, PROT_READ | PROT_WRITE) != 0) { munmap(stk, kGuestStackGuard + size); return 0; }
+    return (u64)stk + kGuestStackGuard;
+}
+bool GuestThread::adopt_stack(u64 base, u64 size, u64 reported) {
+    if (depth != 0) return false;
+    munmap((void *)(stack_base - kGuestStackGuard), kGuestStackGuard + stack_size);
+    stack_base = base;
+    stack_size = size;
+    stack_reported = reported;
+    return true;
+}
 // After a longjmp out of call() (pthread_exit) the Jit still counts as executing: its state is abandoned (leaked,
 // destroying it could assert) and the thread gets a fresh one for whatever guest code still runs on it (TSD
 // destructors at thread exit).
