diff --git a/linux/arm64jit/host.cpp b/linux/arm64jit/host.cpp
index 05f5b4f..dc2d04a 100644
--- a/linux/arm64jit/host.cpp
+++ b/linux/arm64jit/host.cpp
@@ -1327,6 +1327,19 @@ static void install_fault_report() {
     sa.sa_sigaction = on_fault; sa.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_NODEFER;
     sigaction(SIGSEGV, &sa, &g_old_segv); sigaction(SIGBUS, &sa, &g_old_bus);
 }
+// A guest sigaction for SIGSEGV or SIGBUS (crash reporters install one) goes through Darling's __sigaction, which
+// puts Darling's own handler on the Linux signal in place of on_fault. on_fault is the one that must see them: it
+// serves the translator's routine faults (a tagged, non-canonical address faults into dynarmic's fastmem handler,
+// which drops the tag) and delivers real guest faults to the guest's handler (guest_fault_now). Through Darling's
+// handler every routine fault cost a darlingserver round trip (interrupt_enter, sigprocess, interrupt_exit, about
+// 1.4 ms): Swift string code with tagged pointers then ran at a few hundred iterations a second and News never drew
+// its first frame. signals.cpp calls this after every such sigaction to put on_fault back.
+void reassert_fault_handlers() {
+    struct sigaction sa{}, cur{};
+    sa.sa_sigaction = on_fault; sa.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_NODEFER;
+    if (sigaction(SIGSEGV, nullptr, &cur) == 0 && cur.sa_sigaction != on_fault) sigaction(SIGSEGV, &sa, nullptr);
+    if (sigaction(SIGBUS, nullptr, &cur) == 0 && cur.sa_sigaction != on_fault) sigaction(SIGBUS, &sa, nullptr);
+}
 
 void print_stats() {
     peek();
